<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "client": the client program, signed before it goes into its installer, so Defender
     and attack surface reduction rules on the computers know who made it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Rabbid Lab" product-version="${version}">
      <include path="RabbidLab-Client.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
