<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rabbid Lab's update engine (UpdateEngine.cs): deciding when a newer release installs, checking Rabbid Lab's
       release signature, downloading and verifying the installer, and running it. It knows nothing of the web console,
       the license or the settings: the console tells it those through IUpdateSource and IUpdateHost. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Rabbid Lab</Product>
    <Company>Rabbid</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
