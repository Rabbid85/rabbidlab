<?xml version="1.0" encoding="utf-8"?>
<!-- Group Policy for the Rabbid Lab client: Computer Configuration > Administrative Templates > Rabbid Lab > Client.
     Copy this file to PolicyDefinitions and en-US\RabbidLab.adml to PolicyDefinitions\en-US (the central store, or a
     computer's C:\Windows\PolicyDefinitions). The settings land in HKLM\Software\Policies\Rabbid Lab\Client. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0"
                   xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="rabbidlab" namespace="Rabbid.Policies.RabbidLab" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="RabbidLab" displayName="$(string.RabbidLab)" />
    <category name="Client" displayName="$(string.Client)">
      <parentCategory ref="RabbidLab" />
    </category>
  </categories>
  <policies>
    <policy name="Server" class="Machine" displayName="$(string.Server)" explainText="$(string.Server_Help)" presentation="$(presentation.Server)"
            key="Software\Policies\Rabbid Lab\Client">
      <parentCategory ref="Client" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="Server" valueName="Server" required="true" maxLength="255" />
      </elements>
    </policy>
    <policy name="CertificateFingerprint" class="Machine" displayName="$(string.CertificateFingerprint)" explainText="$(string.CertificateFingerprint_Help)"
            presentation="$(presentation.CertificateFingerprint)" key="Software\Policies\Rabbid Lab\Client">
      <parentCategory ref="Client" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="CertificateFingerprint" valueName="CertificateFingerprint" required="true" maxLength="128" />
      </elements>
    </policy>
    <policy name="AllowAccountChanges" class="Machine" displayName="$(string.AllowAccountChanges)" explainText="$(string.AllowAccountChanges_Help)"
            key="Software\Policies\Rabbid Lab\Client" valueName="AllowAccountChanges">
      <parentCategory ref="Client" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
  </policies>
</policyDefinitions>
