<?xml version="1.0" encoding="utf-8"?>
<!-- Which .NET Framework the client runs on. Its windows fit themselves to the screen (Look.Fit), so nothing else is set here. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
