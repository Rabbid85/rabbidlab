<!--
  The Rabbid Lab client for one computer: RabbidLab-Client.exe in Program Files\Rabbid Lab Client, the RabbidLabClient
  service that joins the server and checks in, and the tray icon at every sign-in. Quiet with Group Policy and Intune:
    msiexec /i RabbidLab-Client.msi /qn SERVER=https://rabbidlab.amw.com:8420 FINGERPRINT=AB12...
  Group Policy settings (the Rabbid Lab template) win over SERVER and FINGERPRINT. Run by hand with neither, the
  installer a server's console hands out connects to that server: its file name says which.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Rabbid Lab Client" Manufacturer="Rabbid" Version="$(Version)" UpgradeCode="C344F3AC-01E7-4D01-AB7E-C0BB0DF38689" Scope="perMachine" Compressed="yes">
    <!-- The same version built again replaces the one installed, not a second entry beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of the Rabbid Lab client is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="rabbidlab.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="rabbidlab.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Rabbid85/rabbidlab" />
    <Property Id="SERVER" Secure="yes" />
    <Property Id="FINGERPRINT" Secure="yes" />
    <!-- What was given before, read back so a repair or an update with nothing on the command line keeps it. -->
    <Property Id="SAVEDSERVER">
      <RegistrySearch Id="SavedServer" Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client" Name="Server" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SAVEDFINGERPRINT">
      <RegistrySearch Id="SavedFingerprint" Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client" Name="CertificateFingerprint" Type="raw" Bitness="always64" />
    </Property>
    <!-- The fingerprint first: the saved one is for the saved server, never for a new SERVER. -->
    <SetProperty Action="RememberFingerprint" Id="FINGERPRINT" Value="[SAVEDFINGERPRINT]" After="AppSearch" Sequence="both" Condition="NOT SERVER AND NOT FINGERPRINT AND SAVEDFINGERPRINT" />
    <SetProperty Action="RememberServer" Id="SERVER" Value="[SAVEDSERVER]" After="RememberFingerprint" Sequence="both" Condition="NOT SERVER AND SAVEDSERVER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Rabbid Lab Client">
        <Component Id="Program">
          <File Id="ClientExe" Source="$(ClientDir)\RabbidLab-Client.exe" KeyPath="yes">
            <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Rabbid Lab Client" Description="Shows this computer's Rabbid Lab connection status."
                      WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="rabbidlab.ico" />
          </File>
          <File Id="ClientConfig" Source="$(ClientDir)\RabbidLab-Client.exe.config" />
          <ServiceInstall Name="RabbidLabClient" DisplayName="Rabbid Lab Client" Description="Connects this computer to the Rabbid Lab server for management."
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="--service" Vital="yes" />
          <ServiceControl Id="ClientService" Name="RabbidLabClient" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <!-- The tray icon for everyone who signs in. -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="Rabbid Lab Client" Type="string" Value="&quot;[#ClientExe]&quot; --tray" />
          <!-- This installer's own file name, as it was run. The one a server's console hands out has that server in its
               name; the service reads it once when it starts and, on a computer with no server, connects there
               (Settings.Adopt in the client). No link or web page can start the client: it registers no URL scheme. -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client" Name="Package" Type="string" Value="[OriginalDatabase]" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- The client's own files (status.json, its identity, downloaded updates) are in %ProgramData%Rabbid Lab Client. The
         service makes that folder when it first starts and sets its permissions (Folder.Secure in Settings.cs): the
         installer doesn't, because permissions set on a path are set on wherever a link planted at that path leads. -->

    <!-- What the installer was given, or was given before (SAVEDSERVER). Kept through updates and uninstalls (Permanent),
         and not written when there has never been a SERVER. -->
    <Component Id="Settings" Directory="INSTALLFOLDER" Condition="SERVER" Permanent="yes" Bitness="always64">
      <RegistryKey Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client">
        <RegistryValue Name="Server" Type="string" Value="[SERVER]" KeyPath="yes" />
        <RegistryValue Name="CertificateFingerprint" Type="string" Value="[FINGERPRINT]" />
      </RegistryKey>
    </Component>

    <!-- QUIET=1 (the deploy GPO gives it): nothing for people at the computer to see, no tray icon and no messages. Kept
         through updates. The Rabbid Lab template's Hide the client policy wins over it either way. -->
    <Property Id="QUIET" Secure="yes" />
    <Component Id="QuietSetting" Directory="INSTALLFOLDER" Condition="QUIET" Permanent="yes" Bitness="always64">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client" Name="Quiet" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Uninstalling is locked once the client has joined a server, until someone allows it in Rabbid Lab (Devices). The
         service writes RemovalAllowed when the server says so, and when there is no server (Removal.cs). An update
         replacing this version is never held up. -->
    <Property Id="REMOVALALLOWED">
      <RegistrySearch Id="RemovalAllowed" Root="HKLM" Key="SOFTWARE\Rabbid Lab\Client" Name="RemovalAllowed" Type="raw" Bitness="always64" />
    </Property>
    <CustomAction Id="RemovalLocked" Error="Uninstall of the Rabbid Lab client is locked on this computer. To uninstall the client, open Rabbid Lab Client from the Start menu, click Uninstall, and enter this computer's uninstall code. Or ask an admin to allow the uninstall in Rabbid Lab: go to Devices, click Uninstall next to this computer, and then click Allow." />
    <!-- The tray icon straight away for whoever installed it by hand; a quiet install shows it at the next sign-in. -->
    <CustomAction Id="StartTray" FileRef="ClientExe" ExeCommand="--tray" Return="asyncNoWait" Impersonate="yes" />
    <!-- Defender's attack surface reduction rules block new, unsigned programs: this one file is let past them, as SYSTEM
         before the service starts, until the client is code-signed. Uninstalling takes it out again. -->
    <CustomAction Id="AllowInDefender" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Add-MpPreference -AttackSurfaceReductionOnlyExclusions '[#ClientExe]'&quot;" />
    <CustomAction Id="ForgetInDefender" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Remove-MpPreference -AttackSurfaceReductionOnlyExclusions '[#ClientExe]'&quot;" />
    <InstallExecuteSequence>
      <Custom Action="RemovalLocked" After="AppSearch" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REMOVALALLOWED" />
      <Custom Action="AllowInDefender" Before="StartServices" Condition="NOT REMOVE" />
      <Custom Action="ForgetInDefender" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StartTray" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt; 2" />
    </InstallExecuteSequence>
    <InstallUISequence>
      <Custom Action="RemovalLocked" After="AppSearch" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REMOVALALLOWED" />
    </InstallUISequence>

    <Feature Id="Client" Title="Rabbid Lab Client">
      <ComponentRef Id="Program" />
      <ComponentRef Id="Settings" />
      <ComponentRef Id="QuietSetting" />
    </Feature>
  </Package>
</Wix>
