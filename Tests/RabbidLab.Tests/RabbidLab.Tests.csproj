<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\RabbidLab.Server\RabbidLab.Server.csproj" />
  </ItemGroup>

  <!-- Setup's DNS decisions (DnsPlan.cs) are tested through the server, which compiles them in for console addresses. -->

  <ItemGroup>
    <!-- How the client knows its server (Pin.cs), tested against the certificates the server makes. -->
    <Compile Include="..\..\Src\Client\RabbidLab.Client\Pin.cs" Link="Client\Pin.cs" />
  </ItemGroup>

</Project>
