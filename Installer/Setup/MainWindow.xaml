<Window x:Class="RabbidLab.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rabbid Lab Setup" Width="880" Height="560" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" WindowStyle="None" Background="{StaticResource PanelSolid}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <!-- One dark window: the title bar; the page (a heading, what it does in plain words, and the actions Setup will take);
       and the bar along the foot, with a link on the left and the buttons on the right. -->
  <Grid x:Name="Root" Background="{StaticResource PanelSolid}">
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The title bar -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Chrome}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimise_Click" ToolTip="Minimize">
            <Path Data="M0,0 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1.1" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource Chrome}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1.1" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Viewbox Width="14" Height="16" Margin="0,0,9,0">
            <Canvas Width="50" Height="57">
              <Canvas.Clip><RectangleGeometry Rect="0,0,50,57" RadiusX="11" RadiusY="11" /></Canvas.Clip>
              <Rectangle Width="50" Height="57" Fill="#0B0C14" />
              <Canvas>
                <Canvas.RenderTransform><TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform X="0" Y="8.5" /></TransformGroup></Canvas.RenderTransform>
                <Rectangle Width="11" Height="40" Fill="#F2F3FA" />
                <Path Fill="#F2F3FA" Data="F0 M0,0 H18 A13,13 0 0 1 18,26 H0 Z M11,9 V17 H18 A4,4 0 0 0 18,9 Z" />
                <Path Fill="#F2F3FA" Data="M13,22 H24 L33,40 H22 Z" />
              </Canvas>
              <Rectangle Canvas.Left="37.8" Canvas.Top="30.7" Width="12.2" Height="17.8" RadiusX="1.1" RadiusY="1.1" Fill="#FF6A45" />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="TitleText" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="Rabbid Lab Setup" />
          <!-- Rabbid Lab Dev only (DevLook). -->
          <Border x:Name="DevTag" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,1,6,1" CornerRadius="4" Background="#F2BE6B">
            <TextBlock Text="DEV" FontSize="11" FontWeight="ExtraBold" Foreground="#0B0C14" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The bar along the foot: a link on the left, the buttons on the right. -->
    <DockPanel Grid.Row="2" Margin="28,12,28,20" LastChildFill="False">
      <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Next" Click="Next_Click" IsDefault="True" />
      <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Cancel" Click="Back_Click" Margin="0,0,8,0" />
      <Button x:Name="SettingsButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Change installation settings" VerticalAlignment="Center" Click="ChangeSettings_Click" Visibility="Collapsed" />
      <Button x:Name="LogButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="View the setup log" VerticalAlignment="Center" Click="OpenLog_Click" Visibility="Collapsed" />
      <TextBlock x:Name="Problem" DockPanel.Dock="Left" Foreground="{StaticResource Red}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="460" TextWrapping="Wrap" />
    </DockPanel>
    <!-- Step dots (ShowSteps), centred along the foot -->
    <StackPanel x:Name="StepDots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,20" Visibility="Collapsed" />

    <Grid Grid.Row="1" Margin="28,20,28,0">
      <!-- Summary of actions: last page of a new install, first page of an update. -->
      <ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Viewbox Width="22" Height="25" Margin="0,0,10,0" VerticalAlignment="Center">
            <Canvas Width="50" Height="57">
              <Canvas.Clip><RectangleGeometry Rect="0,0,50,57" RadiusX="11" RadiusY="11" /></Canvas.Clip>
              <Rectangle Width="50" Height="57" Fill="#0B0C14" />
              <Canvas>
                <Canvas.RenderTransform><TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform X="0" Y="8.5" /></TransformGroup></Canvas.RenderTransform>
                <Rectangle Width="11" Height="40" Fill="#F2F3FA" />
                <Path Fill="#F2F3FA" Data="F0 M0,0 H18 A13,13 0 0 1 18,26 H0 Z M11,9 V17 H18 A4,4 0 0 0 18,9 Z" />
                <Path Fill="#F2F3FA" Data="M13,22 H24 L33,40 H22 Z" />
              </Canvas>
              <Rectangle Canvas.Left="37.8" Canvas.Top="30.7" Width="12.2" Height="17.8" RadiusX="1.1" RadiusY="1.1" Fill="#FF6A45" />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" Text="Install Rabbid Lab" />
          <!-- Rabbid Lab Dev only (DevLook): DEV beside the heading, so it can't be taken for the release. -->
          <Border x:Name="HeadDevTag" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,2,0,0" Padding="9,2,9,3" CornerRadius="6" Background="#F2BE6B">
            <TextBlock Text="DEV" FontSize="14" FontWeight="ExtraBold" Foreground="#0B0C14" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="WelcomeLead" Style="{StaticResource Lead}" Text="" />
        <Border x:Name="PresetChip" Style="{StaticResource Note}" Visibility="Collapsed">
          <TextBlock x:Name="PresetText" FontSize="12.5" LineHeight="19" />
        </Border>
        <!-- A newer Rabbid Lab than this Setup: Next downloads it and it continues instead (SetupUpdate). -->
        <Border x:Name="NewerChip" Style="{StaticResource Note}" Visibility="Collapsed">
          <TextBlock x:Name="NewerText" FontSize="12.5" LineHeight="19" />
        </Border>


        <!-- What Setup will do (DrawPlan), and under it how long the console is down and what's in this version. -->
        <StackPanel x:Name="Plan" />
        <UniformGrid x:Name="Facts" Rows="1" Margin="-5,10,-5,0" />
      </StackPanel>
      </ScrollViewer>

      <!-- 3. Installation settings: each one as it will be, with Change (ShowSettings). -->
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <TextBlock Style="{StaticResource H1}" Text="Installation settings" />
        <TextBlock x:Name="SettingsLead" Style="{StaticResource Lead}" Text="" />
        <Border Style="{StaticResource Panel}">
          <StackPanel x:Name="SettingsList" />
        </Border>
      </StackPanel>
      </ScrollViewer>

      <!-- 4. Console address. Sized to fit the window in every state (the window never grows). -->
      <ScrollViewer x:Name="AddressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <TextBlock Style="{StaticResource H1}" Text="Console address" />
        <TextBlock Style="{StaticResource Lead}" Text="Rabbid Lab is opened in a browser at this computer's name or IP address and this port." />
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="Port" />
            <TextBox x:Name="PortBox" MaxLength="5" TextChanged="Address_Changed" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource Label}" Text="Host name (optional)" />
            <TextBox x:Name="NameBox" Style="{StaticResource ClearableBox}" Tag="For example, rabbidlab or lab.home.lan" TextChanged="Address_Changed" />
          </StackPanel>
        </Grid>
        <CheckBox x:Name="DnsBox" Margin="0,0,0,6" Visibility="Collapsed" Checked="Dns_Changed" Unchecked="Dns_Changed">
          <StackPanel>
            <TextBlock x:Name="DnsTitle" Text="Create a DNS record for this name" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Points the name at this computer, so it keeps working if the IP address changes." />
          </StackPanel>
        </CheckBox>
        <!-- What Setup found when it checked it can add the name: on which DNS server, or why not. -->
        <TextBlock x:Name="DnsCheck" Style="{StaticResource Hint}" Margin="26,0,0,12" Visibility="Collapsed" TextWrapping="Wrap" />
        <TextBlock x:Name="DnsNote" Style="{StaticResource Hint}" Margin="0,0,0,12" Visibility="Collapsed" />
        <Border Style="{StaticResource Panel}" Padding="16,10" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="The console will be available at" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
            <StackPanel x:Name="UrlList" />
          </StackPanel>
        </Border>
        <CheckBox x:Name="FirewallBox" Content="Allow inbound connections through Windows Firewall (Domain and Private profiles)" />
        <CheckBox x:Name="RedirectBox" Content="Redirect requests on port 80 to the console, so the address works without a port number" Margin="0,10,0,0" />
        <!-- Port 80 is another program's (Engine.PortUser): who has it. -->
        <TextBlock x:Name="RedirectNote" Style="{StaticResource Hint}" Margin="26,2,0,0" Visibility="Collapsed" />
      </StackPanel>
      </ScrollViewer>

      <!-- 5. HTTPS certificate -->
      <ScrollViewer x:Name="SecurityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <TextBlock Style="{StaticResource H1}" Text="HTTPS certificate" />
        <TextBlock Style="{StaticResource Lead}" Text="Select the certificate that Rabbid Lab uses to secure the console." />
        <RadioButton x:Name="MakeCertChoice" Style="{StaticResource CardChoice}" GroupName="security" Checked="Security_Changed">
          <StackPanel>
            <TextBlock Text="Create a self-signed certificate (recommended)" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Setup creates and configures the certificate. Browsers on other computers show a security warning until it is trusted. To trust it across the domain, deploy it with Group Policy." />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="OwnCertChoice" Style="{StaticResource CardChoice}" GroupName="security" Checked="Security_Changed">
          <StackPanel>
            <TextBlock Text="Use an existing certificate" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Select a certificate installed on this computer, such as one issued by your enterprise certification authority (CA)." />
            <StackPanel x:Name="CertPicker" Margin="0,10,0,0" Visibility="Collapsed">
              <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CertList" />
              </ScrollViewer>
              <TextBlock x:Name="CertNone" Style="{StaticResource Hint}" Margin="0" Foreground="{StaticResource Amber}" Visibility="Collapsed"
                         Text="No suitable certificate was found on this computer. Import the certificate, with its private key, into the Local Computer &gt; Personal store, and then return to this page." />
            </StackPanel>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="HttpChoice" Style="{StaticResource CardChoice}" GroupName="security" Checked="Security_Changed">
          <StackPanel>
            <TextBlock Text="Do not use HTTPS" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="For testing only. Traffic to the console is not encrypted." />
          </StackPanel>
        </RadioButton>
      </StackPanel>
      </ScrollViewer>

      <!-- Installation options: folder and shortcuts -->
      <ScrollViewer x:Name="OptionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <TextBlock Style="{StaticResource H1}" Text="Installation options" />
        <TextBlock Style="{StaticResource Lead}" Text="Choose where Rabbid Lab is installed and which shortcuts to create." />
        <!-- A newer Rabbid Lab is on GitHub (new installs: shown here, the first page). -->
        <Border x:Name="FolderNewerChip" Style="{StaticResource Note}" Visibility="Collapsed">
          <TextBlock x:Name="FolderNewerText" FontSize="12.5" LineHeight="19" />
        </Border>
        <TextBlock Text="Installation folder" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Title}" Margin="0,0,0,10" />
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="FolderBrowse" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" Margin="8,0,0,0" Click="ChangeFolder_Click" />
          <TextBox x:Name="FolderBox" />
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Settings and data are stored in C:\ProgramData\Rabbid Lab." />
        <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,20" />
        <TextBlock Text="Shortcuts" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Title}" Margin="0,0,0,12" />
        <CheckBox x:Name="DesktopBox" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Create desktop shortcut" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Open the Rabbid Lab console in your browser." />
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="StartMenuBox" Margin="0,0,0,4">
          <StackPanel>
            <TextBlock Text="Create Start menu shortcuts" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Console and Windows service controls." />
          </StackPanel>
        </CheckBox>
        <!-- Only on computers whose Defender has attack surface reduction rules, which block new programs like Rabbid Lab. -->
        <StackPanel x:Name="DefenderSection" Visibility="Collapsed">
          <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16" />
          <TextBlock Text="Microsoft Defender" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Title}" Margin="0,0,0,12" />
          <CheckBox x:Name="DefenderBox" Margin="0,0,0,4">
            <StackPanel>
              <TextBlock Text="Allow Rabbid Lab in Microsoft Defender" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="This computer's attack surface reduction rules block new programs. Setup excludes the Rabbid Lab folder on this computer only." />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>

      <!-- 7. Working: each action as Setup takes it, ticked off as it moves on; the bar stays put at the foot of the page
           while the list grows above it. -->
      <DockPanel x:Name="WorkPage" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="WorkTitle" Style="{StaticResource H1}" Text="Installing Rabbid Lab" />
          <TextBlock Style="{StaticResource Lead}" Text="This takes approximately one minute. Keep this window open until Setup finishes." />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,4">
          <TextBlock x:Name="WorkPercent" DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" Text="0%" />
          <ProgressBar x:Name="WorkBar" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
            <StackPanel>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
                <TextBlock x:Name="WorkHeading" FontSize="12.5" Foreground="{StaticResource Muted}" Text="" />
              </Border>
              <StackPanel x:Name="WorkList" Margin="0,4,0,4" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </DockPanel>

      <!-- 8. Done: it worked, and where to open it; or what went wrong and how to fix it. -->
      <ScrollViewer x:Name="DonePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Grid x:Name="DoneMark" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
            <Ellipse Fill="{StaticResource Green}" />
            <Path Data="M7.5,13.5 L11.5,17.5 L19,9.5" Stroke="#0A0B12" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Grid>
          <!-- Failed: a red cross where the tick goes. -->
          <Grid x:Name="FailMark" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse Fill="{StaticResource Red}" />
            <Path Data="M9,9 L17,17 M17,9 L9,17" Stroke="#0A0B12" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Grid>
          <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" Text="Installation complete" />
        </StackPanel>
        <TextBlock x:Name="DoneLead" Style="{StaticResource Lead}" Text="" />
        <!-- The service would not start: how to fix it (ServiceStartException.Fix). -->
        <StackPanel x:Name="FixPanel" Visibility="Collapsed" Margin="0,0,0,14">
          <TextBlock Text="How to fix it" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10" />
          <StackPanel x:Name="FixSteps" />
          <Button x:Name="AllowButton" Style="{StaticResource Primary}" Content="Allow in Microsoft Defender" HorizontalAlignment="Left" Margin="0,6,0,4" Click="Allow_Click" Visibility="Collapsed" />
          <TextBlock x:Name="AllowResult" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
          <TextBlock x:Name="FixCopyLabel" Style="{StaticResource Hint}" Margin="0,12,0,6" />
          <Border x:Name="FixCopyBox" CornerRadius="6" Padding="12,8,8,8" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
              <Button x:Name="FixCopyButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Copy" Margin="10,0,0,0" VerticalAlignment="Center" Click="FixCopy_Click" />
              <TextBox x:Name="FixCopyText" Style="{StaticResource BareBox}" IsReadOnly="True" TextWrapping="Wrap" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
        <Border x:Name="DoneUrls" Style="{StaticResource Panel}" Margin="0,0,0,14">
          <StackPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
              <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" Text="Open the console at any of the following addresses" />
            </Border>
            <StackPanel x:Name="DoneUrlList" Margin="0,2,0,2" />
          </StackPanel>
        </Border>
        <!-- What to do next: after a new installation, how to sign in the first time (Edition.FirstSignIn). -->
        <TextBlock x:Name="DoneNext" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,8" Text="" />
        <!-- Developer options: Rabbid Lab Dev, or Setup started with /devtools. -->
        <Border x:Name="DevTools" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,16,0" VerticalAlignment="Center" Text="Developer" />
              <Button Style="{StaticResource LinkButton}" Content="Remove the Defender exclusion" Margin="0,0,18,0" Click="DevRemoveExclusion_Click" />
              <Button Style="{StaticResource LinkButton}" Content="Show the blocked screen" Click="DevShowBlocked_Click" />
            </StackPanel>
            <TextBlock x:Name="DevResult" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>

      <!-- Removing: what to remove. -->
      <ScrollViewer x:Name="RemovePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,4">
        <TextBlock Style="{StaticResource H1}" Text="Remove Rabbid Lab" />
        <TextBlock x:Name="RemoveLead" Style="{StaticResource Lead}" Text="" />
        <RadioButton x:Name="EverythingChoice" Style="{StaticResource CardChoice}" GroupName="remove" IsChecked="True">
          <StackPanel>
            <TextBlock Text="Remove the program and all of its data" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Removes the program, service, settings, saved credentials, encryption keys, certificate, firewall rule, shortcuts, registry entries and logs. This cannot be undone." />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource CardChoice}" GroupName="remove">
          <StackPanel>
            <TextBlock Text="Remove the program and keep its settings" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock x:Name="DataPathText" Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Select this option if you plan to reinstall. Settings and saved credentials are retained for the new installation." />
          </StackPanel>
        </RadioButton>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- The window's edge, over everything (so the preview's pictures show it too). -->
    <Border Grid.RowSpan="3" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="100" />
  </Grid>
</Window>
