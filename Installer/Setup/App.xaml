<Application x:Class="RabbidLab.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- Setup's look: a dark window in Windows' own font, small controls, Rabbid Lab's ember for the button that goes
       on, and amber, blue and green for the actions Setup lists. Rabbid Lab Dev uses them too, with a DEV tag (DevLook). -->
  <Application.Resources>
    <FontFamily x:Key="Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="PanelSolid" Color="#0A0B12" />
    <SolidColorBrush x:Key="Field" Color="#11131D" />
    <SolidColorBrush x:Key="Line" Color="#1F2232" />
    <SolidColorBrush x:Key="LineStrong" Color="#2A2D3E" />
    <!-- The window's own edge: faint, so it shows where the window ends over other dark windows. -->
    <SolidColorBrush x:Key="WindowEdge" Color="#3C4157" />
    <SolidColorBrush x:Key="RowSep" Color="#161824" />
    <SolidColorBrush x:Key="Text" Color="#E6E8F2" />
    <SolidColorBrush x:Key="Title" Color="#F2F3FA" />
    <SolidColorBrush x:Key="Muted" Color="#8A8FA8" />
    <SolidColorBrush x:Key="Soft" Color="#FFB59E" />
    <!-- Links (Change installation settings and the like): neon purple. -->
    <SolidColorBrush x:Key="Link" Color="#9E59CF" />
    <SolidColorBrush x:Key="Blue" Color="#8FB1FF" />
    <SolidColorBrush x:Key="Green" Color="#5FD4A0" />
    <SolidColorBrush x:Key="Red" Color="#FF6B7D" />
    <SolidColorBrush x:Key="Amber" Color="#F2BE6B" />
    <SolidColorBrush x:Key="Accent" Color="#E8542F" />
    <SolidColorBrush x:Key="AccentLine" Color="#FF6A45" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF7452" />
    <!-- The chosen option card, a field being typed in, and selected text. -->
    <SolidColorBrush x:Key="Picked" Color="#1AE8542F" />
    <SolidColorBrush x:Key="PickedLine" Color="#80FF6A45" />
    <!-- Selected card and certificate row: border only. -->
    <SolidColorBrush x:Key="ChosenLine" Color="#E8542F" />
    <SolidColorBrush x:Key="FocusLine" Color="#FF6A45" />
    <SolidColorBrush x:Key="Selection" Color="#E8542F" />
    <SolidColorBrush x:Key="GhostBack" Color="#1A1C28" />
    <SolidColorBrush x:Key="GhostHover" Color="#222536" />
    <SolidColorBrush x:Key="GhostLine" Color="#2A2D3E" />
    <SolidColorBrush x:Key="GhostText" Color="#E6E8F2" />
    <SolidColorBrush x:Key="TickLine" Color="#4A4E66" />
    <SolidColorBrush x:Key="Placeholder" Color="#5E6380" />
    <SolidColorBrush x:Key="CardBack" Color="#11131D" />
    <SolidColorBrush x:Key="CardHover" Color="#151827" />
    <SolidColorBrush x:Key="Track" Color="#1F2232" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Title}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- A box for a list (the actions, the settings, the addresses): the window's own colour inside a thin line,
         as the facts under the actions; and a note above the page's content. -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Note" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PickedLine}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Buttons: the violet one goes on, the dark one is everything else. -->
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Font}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="5" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="{DynamicResource GhostText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="5" Background="{DynamicResource GhostBack}" BorderBrush="{DynamicResource GhostLine}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource GhostText}" /></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource GhostHover}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Soft}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Link}" />
      <Setter Property="FontFamily" Value="{StaticResource Font}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" TextWrapping="NoWrap" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A small button that's just an icon (Copy beside each address). -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="5" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource GhostHover}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource GhostHover}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The minimise and close buttons on the title bar. -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="33" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1AFFFFFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Font}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="6" Background="{DynamicResource Field}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Placeholder}" FontSize="{TemplateBinding FontSize}" Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="NoWrap" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusLine}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The × that clears a text box: grey, lighter with a round backing on hover. Not a tab stop, so typing isn't interrupted. -->
    <Style x:Key="ClearButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="30" />
      <Setter Property="ToolTip" Value="Clear" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Ellipse x:Name="back" Width="20" Height="20" Fill="Transparent" />
              <Path x:Name="mark" Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="mark" Property="Stroke" Value="{DynamicResource Text}" />
                <Setter TargetName="back" Property="Fill" Value="{DynamicResource LineStrong}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A text box with an × on the right that empties it, shown while there's something to clear. -->
    <Style x:Key="ClearableBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="6" Background="{DynamicResource Field}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Placeholder}" FontSize="{TemplateBinding FontSize}" Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="NoWrap" />
                <Button x:Name="clear" Grid.Column="1" Style="{StaticResource ClearButton}" Margin="0,0,2,0" Click="ClearBox_Click" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                <Setter TargetName="clear" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="clear" Property="Visibility" Value="Collapsed" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusLine}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                <Setter TargetName="clear" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A text box without its own box, for fields drawn around it and text to copy. -->
    <Style x:Key="BareBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="Auto" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="Transparent">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Placeholder}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                         Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="NoWrap" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Font}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="17" Height="17" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource TickLine}" Background="{DynamicResource Field}" VerticalAlignment="Top" Margin="0,1,10,0">
                <Path x:Name="tick" Data="M3.2,7.6 L6.1,10.4 L11.6,4.6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Stretch="None" />
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Soft}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A certificate to pick, inside a card choice: a slimmer row. -->
    <Style x:Key="CertChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="row" CornerRadius="6" Padding="12,8" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource PanelSolid}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top">
                  <Ellipse x:Name="ring" Stroke="{DynamicResource TickLine}" StrokeThickness="1.5" Fill="Transparent" />
                  <Ellipse x:Name="dot" Width="6" Height="6" Fill="White" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Grid.Column="1" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource LineStrong}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource ChosenLine}" />
                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}" />
                <Setter TargetName="ring" Property="Stroke" Value="Transparent" />
                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Keyboard focus around a card: shown only when tabbing, never on a click. -->
    <Style x:Key="CardFocus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Margin="-3" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A choice shown as a card: the picked one gets an accent border. -->
    <Style x:Key="CardChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocus}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="card" CornerRadius="8" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource CardBack}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                  <Ellipse x:Name="ring" Stroke="{DynamicResource TickLine}" StrokeThickness="1.5" Fill="{DynamicResource Field}" />
                  <Ellipse x:Name="dot" Width="6" Height="6" Fill="White" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Grid.Column="1" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource CardHover}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource ChosenLine}" />
                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}" />
                <Setter TargetName="ring" Property="Stroke" Value="Transparent" />
                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border CornerRadius="3" Background="{DynamicResource Track}" />
              <Border x:Name="PART_Track" />
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scroll bars: faint until hovered. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="bar" CornerRadius="3" Background="{DynamicResource LineStrong}" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource TickLine}" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource Muted}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
